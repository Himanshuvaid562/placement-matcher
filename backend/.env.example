PORT=5000
MONGO_URI=mongodb://localhost:27017/p06_placement
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters_xxxxxxxxxxxx
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Required to create Placement Officer accounts via /auth/register. Leave empty to disable.
OFFICER_INVITE_CODE=change-me-officer-invite
# Public address of the FRONTEND. Used to build the recruiter verification links (https://<this>/verify/<token>)
PUBLIC_APP_URL=http://localhost:3000
# Highest skill level (1-5) a faculty-verified certificate can support in match scores. An assessment can go higher.
CERTIFICATE_LEVEL_CAP=3
